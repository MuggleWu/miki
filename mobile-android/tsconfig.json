{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["../src/core/*"],
      "@shared/*": ["../src/shared/*"],
      "@mobile/*": ["src/mobile/*"],
      "@ui/*": ["src/ui/*"]
    }
  },
  "include": ["src", "vite.config.ts", "capacitor.config.ts"]
}

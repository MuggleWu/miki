{
  "name": "miki",
  "version": "0.1.0",
  "description": "个人单机刷卡软件：普通卡片 + FSRS-6 调度",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "postinstall": "node scripts/fix-dev-app-name.js",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pack:mac": "npm run build && electron-builder --dir",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.mugglewu.miki",
    "productName": "Miki",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "asar": true,
    "mac": {
      "icon": "resources/icon.png",
      "identity": null,
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ]
    }
  },
  "dependencies": {
    "echarts": "^5.5.0",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.4.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "productName": "Miki"
}
